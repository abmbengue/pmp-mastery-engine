generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AcademyStatus {
  PLANNED
  ACTIVE
}

enum Locale {
  FR
  EN
}

enum LearningItemType {
  TEXT
  VIDEO
  EXERCISE
  QUIZ
  FLASHCARD
  SIMULATION
  ASSESSMENT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  NUMERIC
  CALCULATION
  SITUATIONAL
  /// Reserved for future exam item types (architecture only in Phase 7)
  DRAG_DROP
  MATCHING
}

enum PmpDomain {
  PEOPLE
  PROCESS
  BUSINESS_ENVIRONMENT
}

enum PmpDeliveryApproach {
  AGILE
  HYBRID
  PREDICTIVE
}

enum ExamDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamType {
  QUICK_PRACTICE
  DOMAIN_PRACTICE
  MOCK_EXAM
  FULL_PMP
}

enum ExamSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PmpScenarioType {
  FIRST_ACTION
  NEXT_ACTION
  BEST_ACTION
  PREVENTION
  ROOT_CAUSE
  STAKEHOLDER
  RISK
  CHANGE
  CONFLICT
  AGILE
  HYBRID
  GOVERNANCE
}

enum LearningObjective {
  IDENTIFY
  APPLY
  ANALYZE
  DECIDE
}

enum ExamErrorCategory {
  KNOWLEDGE_GAP
  MISREAD_SCENARIO
  WRONG_PRIORITY
  WRONG_ACTION
  AGILE_MINDSET
  STAKEHOLDER_ERROR
  RISK_ERROR
  PROCESS_ERROR
  OTHER
}

enum RetryType {
  RETRY_WRONG_QUESTIONS
  RETRY_WEAK_SKILLS
  RETRY_WEAK_DOMAIN
  RETRY_ERROR_TYPE
  RETRY_MIXED
}

enum ScoreTrend {
  IMPROVING
  STABLE
  DECLINING
  INSUFFICIENT_DATA
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MasteryLevel {
  WEAK
  LEARNING
  MASTERED
}

enum ContentDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ---------------------------------------------------------------------------
// Content hierarchy: Academy → Course → Module → Lesson → LearningItem
// ---------------------------------------------------------------------------

model Academy {
  id            String        @id @default(cuid())
  slug          String        @unique
  titleFr       String
  titleEn       String
  descriptionFr String        @db.Text
  descriptionEn String        @db.Text
  status        AcademyStatus @default(PLANNED)
  sortOrder     Int           @default(0)
  courses       Course[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Course {
  id               String       @id @default(cuid())
  academyId        String
  academy          Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  slug             String
  titleFr          String
  titleEn          String
  descriptionFr    String       @db.Text
  descriptionEn    String       @db.Text
  sortOrder        Int          @default(0)
  estimatedMinutes Int?
  modules          Module[]
  enrollments      Enrollment[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([academyId, slug])
}

model Module {
  id               String   @id @default(cuid())
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug             String
  titleFr          String
  titleEn          String
  descriptionFr    String   @db.Text
  descriptionEn    String   @db.Text
  // Content structure category (e.g. FOUNDATIONS, DEBT, PEOPLE, AGILE)
  category         String?
  sortOrder        Int      @default(0)
  estimatedMinutes Int?
  lessons          Lesson[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([courseId, slug])
}

model Lesson {
  id               String            @id @default(cuid())
  moduleId         String
  module           Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug             String
  titleFr          String
  titleEn          String
  descriptionFr    String            @db.Text
  descriptionEn    String            @db.Text
  sortOrder        Int               @default(0)
  estimatedMinutes Int?
  difficulty       ContentDifficulty @default(BEGINNER)
  // Micro-learning phase durations — configurable per lesson, NOT hardcoded
  learnMinutes     Int?
  practiceMinutes  Int?
  testMinutes      Int?
  reviewMinutes    Int?
  masterMinutes    Int?
  learningItems    LearningItem[]
  lessonProgress   LessonProgress[]
  skills           LessonSkill[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([moduleId, slug])
}

model LearningItem {
  id         String           @id @default(cuid())
  lessonId   String
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type       LearningItemType
  sortOrder  Int              @default(0)
  payload    Json
  difficulty Int              @default(1)
  questions  Question[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Skills & Assessment
// ---------------------------------------------------------------------------

model Skill {
  id            String           @id @default(cuid())
  slug          String           @unique
  titleFr       String
  titleEn       String
  descriptionFr String?          @db.Text
  descriptionEn String?          @db.Text
  questions     Question[]
  questionLinks QuestionSkill[]
  masteries     ConceptMastery[]
  lessons       LessonSkill[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// Many-to-many: a lesson can map to several concepts/skills
model LessonSkill {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([lessonId, skillId])
  @@index([skillId])
}

model Question {
  id                   String                 @id @default(cuid())
  /// Stable seed key for exam-bank upserts (never expose as correct-answer hint)
  externalKey          String?                @unique
  learningItemId       String?
  learningItem         LearningItem?          @relation(fields: [learningItemId], references: [id], onDelete: SetNull)
  skillId              String?
  skill                Skill?                 @relation(fields: [skillId], references: [id], onDelete: SetNull)
  type                 QuestionType
  promptFr             String                 @db.Text
  promptEn             String                 @db.Text
  explanationCorrectFr String                 @db.Text
  explanationCorrectEn String                 @db.Text
  /// Legacy numeric difficulty (1–3). Prefer examDifficulty for exam bank.
  difficulty           Int                    @default(1)
  category             String?
  /// When true, question belongs to the PMP exam practice bank
  examBank             Boolean                @default(false)
  pmpDomain            PmpDomain?
  deliveryApproach     PmpDeliveryApproach?
  processArea          String?
  examDifficulty       ExamDifficulty?
  scenarioFr           String?                @db.Text
  scenarioEn           String?                @db.Text
  /// Pedagogical scenario category (PLA Learning Blueprint — not PMI)
  scenarioType         PmpScenarioType?
  learningObjective    LearningObjective?
  answerOptions        AnswerOption[]
  quizAttempts         QuizAttempt[]
  skillLinks           QuestionSkill[]
  examSessionQuestions ExamSessionQuestion[]
  examErrors           ExamError[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([examBank, pmpDomain])
  @@index([examBank, deliveryApproach])
  @@index([examBank, scenarioType])
}

/// Extra skills linked to a question (in addition to primary skillId)
model QuestionSkill {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([questionId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// PMP Exam Simulator (Phase 7)
// ---------------------------------------------------------------------------

/// Exam template / configuration (duration lives here — never hardcoded in React)
model Exam {
  id               String        @id @default(cuid())
  slug             String        @unique
  type             ExamType
  titleFr          String
  titleEn          String
  descriptionFr    String        @db.Text
  descriptionEn    String        @db.Text
  questionCount    Int
  /// Configurable timer in minutes (0 = untimed practice)
  durationMinutes  Int           @default(0)
  domainFilter     PmpDomain?
  isActive         Boolean       @default(true)
  sessions         ExamSession[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ExamSession {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  status           ExamSessionStatus     @default(NOT_STARTED)
  currentIndex     Int                   @default(0)
  elapsedSeconds   Int                   @default(0)
  remainingSeconds Int?
  startedAt        DateTime?
  completedAt      DateTime?
  /// Deterministic RNG seed used by the exam builder (testable randomization)
  blueprintSeed    String?
  retryType        RetryType?
  parentSessionId  String?
  parentSession    ExamSession?          @relation("ExamRetryChain", fields: [parentSessionId], references: [id], onDelete: SetNull)
  childRetries     ExamSession[]         @relation("ExamRetryChain")
  questions        ExamSessionQuestion[]
  result           ExamResult?
  errors           ExamError[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([userId, status])
  @@index([userId, examId])
  @@index([parentSessionId])
}

model ExamSessionQuestion {
  id         String       @id @default(cuid())
  sessionId  String
  session    ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder  Int
  flagged    Boolean      @default(false)
  answer     ExamAnswer?
  error      ExamError?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([sessionId, questionId])
  @@unique([sessionId, sortOrder])
  @@index([questionId])
}

model ExamAnswer {
  id                String               @id @default(cuid())
  sessionQuestionId String               @unique
  sessionQuestion   ExamSessionQuestion  @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  selectedOptionIds Json
  answeredAt        DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model ExamResult {
  id                    String      @id @default(cuid())
  sessionId             String      @unique
  session               ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawScore              Int
  percentage            Float
  correctCount          Int
  incorrectCount        Int
  unansweredCount       Int
  domainBreakdown       Json
  skillBreakdown        Json
  deliveryBreakdown     Json?
  errorBreakdown        Json?
  /// Practice readiness only — NOT official PMI scoring
  readinessLevel        String
  readinessExplanationFr String?    @db.Text
  readinessExplanationEn String?    @db.Text
  scoreTrend            ScoreTrend?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

/// Deterministic error history for pedagogical profiling (not LLM scoring)
model ExamError {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String
  session           ExamSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionQuestionId String               @unique
  sessionQuestion   ExamSessionQuestion  @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skillSlug         String?
  domain            PmpDomain?
  category          ExamErrorCategory
  /// Optional learner self-tag during review
  learnerOverride   ExamErrorCategory?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, category])
  @@index([userId, skillSlug])
  @@index([userId, questionId])
}

/// User pedagogical practice target (not PMI pass threshold)
model PracticeTarget {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Target practice score percent: 70 | 75 | 80 | 85
  targetScorePercent Int      @default(75)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AnswerOption {
  id                 String   @id @default(cuid())
  questionId         String
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  labelFr            String
  labelEn            String
  isCorrect          Boolean  @default(false)
  explanationWrongFr String?  @db.Text
  explanationWrongEn String?  @db.Text
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Users & Progress
// ---------------------------------------------------------------------------

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String
  passwordHash     String?
  /** Null = not verified (pilot allows login anyway). Future email verification. */
  emailVerifiedAt  DateTime?
  locale           Locale              @default(FR)
  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  quizAttempts     QuizAttempt[]
  conceptMasteries ConceptMastery[]
  learningStreak   LearningStreak?
  examSessions     ExamSession[]
  examErrors       ExamError[]
  practiceTarget   PracticeTarget?
  passwordResetTokens PasswordResetToken[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

/// One-time password reset tokens (store hash only — never plaintext)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       LessonProgressStatus @default(NOT_STARTED)
  timeSpentSec Int                  @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  // Stores resumable player state: { currentPhase, quizScore, masteryLevel }
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, lessonId])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  learningItemId String?
  score          Float
  answers        Json
  attemptNo      Int      @default(1)
  isCorrect      Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ConceptMastery {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level          MasteryLevel @default(WEAK)
  lastReviewedAt DateTime?
  /** Deterministic spaced-repetition due date (Phase 10) */
  nextReviewAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, skillId])
  @@index([userId, nextReviewAt])
}

model LearningStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
